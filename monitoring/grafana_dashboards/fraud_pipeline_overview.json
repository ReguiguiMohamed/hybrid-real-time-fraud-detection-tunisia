{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Pipeline Throughput (tx/sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(kafka_topic_messages_in_total{topic=\"tunisian_transactions\"}[1m])",
          "legendFormat": "Kafka Ingest Rate"
        },
        {
          "expr": "rate(fraud_predictions_total[1m])",
          "legendFormat": "ML Predictions/sec"
        },
        {
          "expr": "rate(fraud_alerts_total{alert_type=\"high_risk\"}[1m])",
          "legendFormat": "High-Risk Alerts/sec"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Ingestion Latency (P95/P99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(fraud_ingestion_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, rate(fraud_ingestion_latency_seconds_bucket[5m]))",
          "legendFormat": "P99 Latency"
        }
      ],
      "thresholds": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 1.0},
        {"color": "red", "value": 2.0}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{consumer_group}} - {{topic}}"
        }
      ],
      "thresholds": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 500},
        {"color": "red", "value": 1000}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Model Performance (F1 / AUC)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "model_f1_score",
          "legendFormat": "F1 Score"
        },
        {
          "expr": "model_auc",
          "legendFormat": "AUC"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "title": "DLQ Status",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "dlq_pending_count",
          "legendFormat": "Pending"
        },
        {
          "expr": "dlq_failed_count",
          "legendFormat": "Failed"
        },
        {
          "expr": "dlq_success_count",
          "legendFormat": "Resolved"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}
    },
    {
      "title": "Feedback Processing",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "feedback_confirmed_fraud_total",
          "legendFormat": "Confirmed Fraud"
        },
        {
          "expr": "feedback_false_positive_total",
          "legendFormat": "False Positive"
        },
        {
          "expr": "feedback_precision",
          "legendFormat": "Precision"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16}
    },
    {
      "title": "Resource Usage (JVM Memory)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_bytes_used / jvm_memory_bytes_max",
          "legendFormat": "{{area}} - {{id}}"
        }
      ],
      "thresholds": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 0.75},
        {"color": "red", "value": 0.85}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
    },
    {
      "title": "Alert Distribution by Type",
      "type": "piechart",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (alert_type) (rate(fraud_alerts_total[1h]))",
          "legendFormat": "{{alert_type}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["fraud-detection", "amastan", "pipeline"],
  "templating": {
    "list": [
      {
        "current": {"text": "production", "value": "production"},
        "name": "environment",
        "options": [
          {"selected": true, "text": "production", "value": "production"},
          {"selected": false, "text": "staging", "value": "staging"}
        ],
        "type": "custom"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "title": "Amastan Fraud Pipeline Overview",
  "uid": "amastan-fraud-pipeline",
  "version": 1
}
