# Required API tokens
ADMIN_TOKEN=replace_me
ANALYST_TOKEN=replace_me

# SQLite works locally. The hosted demo uses Neon PostgreSQL.
DATABASE_URL=sqlite:///./data/feedback.db
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Protects the public Prometheus endpoint.
METRICS_TOKEN=replace_me

# Optional runtime settings
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_POOL_RECYCLE_SECONDS=300
CHANGE_AUDIT_LOG=./data/audit/change_audit.jsonl
TUNISIA_ISLAMIC_HOLIDAYS=
