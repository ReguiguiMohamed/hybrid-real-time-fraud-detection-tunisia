# =============================================================================
# Hybrid Real-Time Fraud Detection System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Do NOT commit the .env file to version control.

# --- Authentication ---
# API token for admin operations (alert ingestion, model retraining)
ADMIN_TOKEN=change_me_admin_token_here
# API token for analyst operations (feedback, review queue)
ANALYST_TOKEN=change_me_analyst_token_here
# Legacy single-token mode (used by docker-compose, defaults to admin)
API_TOKEN=change_me_api_token_here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- API ---
COMMAND_CENTER_API_URL=http://api:8001
COMMAND_CENTER_API_TOKEN=${API_TOKEN}

# --- Dashboard ---
DASHBOARD_USER_ID=analyst_01

# --- ML Model Retraining ---
# Minimum feedback records required before retraining is triggered
RETRAIN_FEEDBACK_THRESHOLD=100
# Minimum feedback records for retraining eligibility
RETRAIN_MIN_FEEDBACK=100
# F1 improvement required to promote challenger over champion
CHAMPION_PROMOTION_THRESHOLD=0.02
# User ID recorded in audit logs for automated model promotions
MODEL_PROMOTION_USER=system

# --- Streaming Consumer ---
# Uncertainty zone for active learning sampling (low,high)
UNCERTAINTY_ZONE=0.4,0.6
# Fraction of low-risk transactions to randomly sample for review
RANDOM_SAMPLE_RATE=0.01
# Maximum ML probability for random sample eligibility
RANDOM_SAMPLE_MAX_PROB=0.1
# Number of concurrent workers for alert processing
THREAD_POOL_SIZE=5
# Timeout for async alert processing (seconds)
ALERT_ASYNC_TIMEOUT_SECONDS=15

# --- Dead Letter Queue ---
# Interval between DLQ retry cycles (seconds)
DLQ_RETRY_INTERVAL_SECONDS=60
# Maximum retry attempts for failed alerts
DLQ_RETRY_MAX_ATTEMPTS=3

# --- Drift Detection ---
# Hours of data to consider for drift detection window
DRIFT_WINDOW_HOURS=24

# --- Hadoop (for local Windows development only) ---
# HADOOP_HOME=C:\hadoop-3.4.2

# --- Ollama (RAG/LLM) ---
# OLLAMA_URL=http://localhost:11434/api/generate
