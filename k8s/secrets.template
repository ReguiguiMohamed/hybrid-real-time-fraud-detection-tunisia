# Copy this file outside source control, fill with real values, and apply it
# before deploying workloads:
#   kubectl apply -f fraud-secrets.yml
#
# Do not commit the rendered Secret. Prefer External Secrets Operator or Vault
# injection in production.
apiVersion: v1
kind: Secret
metadata:
  name: fraud-secrets
  namespace: amastan
type: Opaque
stringData:
  api-token: "<set-real-api-token>"
  admin-token: "<set-real-admin-token>"
  analyst-token: "<set-real-analyst-token>"
  pii-salt: "<set-real-pii-salt>"
